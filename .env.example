# Cloudflare Workers AI Configuration
# Get Account ID and API Token from Cloudflare Dashboard (Workers AI free tier)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/cloudflare/clef-flash

# Local System One / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nimble

# Router Backend Provider: 'cloudflare', 'ollama', or 'mock'
ROUTER_BACKEND=cloudflare

# Decision Confidence Thresholds
CONFIDENCE_THRESHOLD_HIGH=0.70
CONFIDENCE_THRESHOLD_LOW=0.40

# Fast-Path Cache Configuration
FAST_PATH_CACHE_ENABLED=true
FAST_PATH_CACHE_TTL_SECONDS=3600
FAST_PATH_CACHE_MAX_SIZE=1024

# Server Configuration
ROUTER_HOST=0.0.0.0
ROUTER_PORT=8000
